=======================================
       BENEFIT BAR POD HEADEROM
       ========================================================= */
    /* wrapper MUSÍ byť mimo sticky flow */
    .pf-sticky-benefit-bar-wrap {
    	position: relative;
    	z-index: 1;
    }

    .pf-sticky-benefit-bar {
    	position: static !important;
    	top: auto !important;
    	z-index: 20;
    	background: #016556;
    	color: #fff;
    	border-bottom: 1px solid rgba(255,255,255,.12);
    }

    .pf-sticky-benefit-bar__inner {
    	max-width: 1280px;
    	margin: 0 auto;
    	padding: 8px 20px;
    	display: flex;
    	align-items: center;
    	justify-content: center;
    	gap: 14px;
    	font-size: 0.9rem;
    	line-height: 1.35;
    	font-weight: 500;
    	text-align: center;
    }

    .pf-sticky-benefit-bar__item {
    	display: flex;
    	align-items: center;
    	gap: 8px;
    	justify-content: center;
    }

    .pf-sticky-benefit-bar__icon {
    	font-size: 0.95em;
    	line-height: 1;
    }

    .pf-sticky-benefit-bar__divider {
    	width: 1px;
    	height: 16px;
    	background: rgba(255,255,255,.28);
    }

    @media (max-width: 767px) {
    	.pf-sticky-benefit-bar__inner {
    		flex-direction: column;
    		gap: 6px;
    		padding: 8px 14px;
    		font-size: 0.8rem;
    	}

    	.pf-sticky-benefit-bar__divider {
    		display: none;
    	}
    }</style><style id="core-block-supports-inline-css">.wp-elements-1 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-9);}.wp-elements-2 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-9);}.wp-elements-3 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-6);}.wp-elements-4 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-6);}.wp-elements-5 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-6);}.wp-container-core-group-is-layout-4fc3f8e1{flex-direction:column;align-items:flex-start;}.wp-elements-6 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-6);}.wp-elements-7 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-7);}.wp-elements-8 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-9);}.wp-elements-9 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-9);}.wp-elements-10 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-6);}.wp-elements-11 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--theme-palette-6);}.wp-container-content-5e2576f9{grid-column:span 1;grid-row:span 1;}.wp-container-content-eeae9679{grid-column:span 1;}.wp-container-core-group-is-layout-928ddffe{grid-template-columns:repeat(2, minmax(0, 1fr));}
