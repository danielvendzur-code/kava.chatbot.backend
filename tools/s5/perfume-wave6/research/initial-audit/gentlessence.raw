					window.rc.retargetingHit({
						rtgId: '423237',
						itemId: upgates.product.id + (upgates.product.options.length > 0 ? '_' + upgates.product.options[0].id : ''),
						pageType: 'offerdetail',
						consent: (upgates.cookies.ads ? 1 : 0)
					});
				} else if (upgates.pageType === 'category') {
					window.rc.retargetingHit({
						rtgId: '423237',
						category: upgates.category.path.join(' | '),
						pageType: 'category',
						consent: (upgates.cookies.ads ? 1 : 0)
					});
				} else {
					window.rc.retargetingHit({
						rtgId: '423237',
						consent: (upgates.cookies.ads ? 1 : 0)
					});
				}
			}
		};

		sklik_retargeting_hit();
		upgates.on('cookies', sklik_retargeting_hit);
