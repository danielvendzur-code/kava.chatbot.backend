<form action="/?do=writeUsRightForm-submit" method="post" id="frm-writeUsRightForm" class="modal-body b bg-wh gapy-4 ai-s flex-col d-flex i" onsubmit="return nette.validateForm(this)"><textarea cols="40" rows="10" name="message" id="frmwriteUsRightForm-message" class="form-control qi-i-1" placeholder="Vaše zpráva" aria-label="Vaše zpráva"></textarea><input type="email" maxlength="254" inputmode="email" name="email" id="frmwriteUsRightForm-email" value="" class="form-control qi-i-2 EmailMask" placeholder="Váš email" aria-label="Váš email">						<button type="button" class="btn fg bg-pr bov-wh-o-20 bgr-l1 sh-sm" name="formSendButton">Odeslat</button>
						<div class="hidden"><input type="text" class="nospam" name="nospam" id="frmwriteUsRightForm-nospam" value=""><input type="submit" name="send" id="frmwriteUsRightForm-send" value=""></div>
<div style="display:none"><input type="hidden" name="question" id="frmwriteUsRightForm-question" value="Sečtěte čísla 8 a 6. (vyplňte číslo)"><input type="hidden" name="answer" id="frmwriteUsRightForm-answer" value=""><input type="hidden" name="check" id="frmwriteUsRightForm-check" value="lyP91bJcx8Aza+m9Va5owA=="><input type="hidden" name="token" id="frmwriteUsRightForm-token" value="6af751c013391"></div>
</form>
<!-- Nette Form validator -->

<script>
	var nette = nette || {};
	nette.getValue = function(a) {
		if (a) {
			if (!a.nodeName) {
				for (var b = 0, d = a.length; b < d; b++)
					if (a[b].checked) return a[b].value;
				return null
			}
			if (a.nodeName.toLowerCase() === "select") {
				b = a.selectedIndex;
				var c = a.options;
				if (b < 0) return null;
				else if (a.type === "select-one") return c[b].value;
				b = 0;
				a = [];
				for (d = c.length; b < d; b++) c[b].selected && a.push(c[b].value);
				return a
			}
			if (a.type === "checkbox") return a.checked;
			return a.value.replace(/^\s+|\s+$/g, "")
		}
	};

	nette.getFormValidators = function(a) {
		a = a.getAttributeNode("id").value;
		return this.forms[a] ? this.forms[a].validators : []
	};
	nette.validateControl = function(a) {
		var b = this.getFormValidators(a.form)[a.name];
		return b ? b(a) : null
	};

	nette.validateForm = function(a) {
		var b = (a.nodeName && a.nodeName.toLowerCase() === "form") ? a : (a.form || a),
			d = this.getFormValidators(b);
		for (var c in d) {
			var e = d[c](a);
			if (e) {
				if (b[c] === undefined) {
					console.log('element: ' + c + ' not found in form');
				}
				b[c].focus && b[c].focus();
				alert(e);
				if (typeof $ != 'undefined') {
					if (parseInt($.fn.jquery.split('.')[1]) >= 11) {
						$('[name=' + c + ']').parents('.form-group').removeClass('has-required').addClass('has-error');
						$('[name=' + c + ']').on('change', function() {
							if ($(this).val() != '') {
								$(this).parents('.form-group').removeClass('has-error').addClass('has-required');
								$(this).off();
							}
						});
					}
				}

				return false
			}
		}
		return true
	};

	nette.toggle = function(a, b) {
		if (a = document.getElementById(a)) a.style.display = b ? "" : "none"
	};
</script>

<script>

nette.forms = nette.forms || { };

nette.forms["frm-writeUsRightForm"] = {
	validators: {
		"nospam": function(sender) {
			var res, val, form = (sender.nodeName && sender.nodeName.toLowerCase() === "form") ? sender : (sender.form || sender);
			val = nette.getValue(form["nospam"]); res = val!='' && val!="";
			if (res) return "Ty jsi spambot.";
		},
		"message": function(sender) {
			var res, val, form = (sender.nodeName && sender.nodeName.toLowerCase() === "form") ? sender : (sender.form || sender);
			val = nette.getValue(form["message"]); res = val!='' && val!="";
			if (!res) return "Va\u0161e zpr\u00e1va je povinn\u00e9 pole.";
		},
		"email": function(sender) {
			var res, val, form = (sender.nodeName && sender.nodeName.toLowerCase() === "form") ? sender : (sender.form || sender);
			val = nette.getValue(form["email"]); res = val!='' && val!="";
			if (!res) return "Email je povinn\u00e9 pole.";
			res = (/^("([ !#-[\]-~]|\[ -~])+"|[-a-z0-9!#$%&'*+/=?^_`{|}~]+(\.[-a-z0-9!#$%&'*+/=?^_`{|}~]+)*)@([0-9a-z\u00C0-\u02FF\u0370-\u1EFF]([-0-9a-z\u00C0-\u02FF\u0370-\u1EFF]{0,61}[0-9a-z\u00C0-\u02FF\u0370-\u1EFF])?\.)+[a-z\u00C0-\u02FF\u0370-\u1EFF]([-0-9a-z\u00C0-\u02FF\u0370-\u1EFF]{0,17}[a-z\u00C0-\u02FF\u0370-\u1EFF])?$/i).test(val = nette.getValue(form["email"]));
			if (!res) return "Email nen\u00ed korektn\u00ed.";
		}
	},

	toggle: function(sender) {
		var visible, res, form = (sender.nodeName && sender.nodeName.toLowerCase() === "form") ? sender : (sender.form || sender);
	}
}



</script>

<!-- /Nette Form validator -->

