    <script>
        /* <![CDATA[ */
        (function () {
                        var adConsent = 'denied';
            var analyticsConsent = 'denied';
            
            function semDebugRequested() {
                var flag = /[?&]semDebug(?:=([^&#]*))?/.exec(window.location.search);
                var switchedOff = flag !== null && (flag[1] === '0' || flag[1] === 'off');

                try {
                    if (switchedOff) {
                        window.sessionStorage.removeItem('semDebug');
                    } else if (flag !== null) {
                        window.sessionStorage.setItem('semDebug', '1');
                    }

                    return window.sessionStorage.getItem('semDebug') === '1';
                } catch (e) {
                    return flag !== null && !switchedOff;
                }
            }

            var debug = semDebugRequested();

            window.semDebug = window.semDebug || [];

            function semLog(loaded, args) {
                var method = args[0];
                var isTrack = method === 'track';
                var payload = isTrack ? args[2] : args[1];
                var label = '[SEM] ' + (isTrack ? args[1] : method) + (loaded ? '' : ' — sul.js NOT LOADED, nothing sent');

                if (typeof console.groupCollapsed !== 'function') {
                    console.log(label, payload);
                    return;
                }

                console.groupCollapsed(label);

                if (payload === undefined) {
                    console.log('[SEM] no payload from us \u2014 sul.js adds the URL, referrer and its own ids');
                } else {
                    console.log('[SEM] ' + JSON.stringify(payload, null, 2));
                }

                console.groupEnd();
            }

            function semCall() {
                var args = Array.prototype.slice.call(arguments);
                var loaded = typeof window.SEM === 'function';

                if (debug) {
                    window.semDebug.push({ loaded: loaded, args: args });
                    semLog(loaded, args);
                }

                if (loaded) {
                    window.SEM.apply(null, args);
                }
            }

            window.semCall = semCall;

            function semConsentPayload(ad, analytics) {
                return {
                    consent_mode: {
                        ad_storage: ad,
                        ad_user_data: ad,
                        ad_personalization: ad,
                        analytics_storage: analytics,
                        functionality_storage: analytics
                    }
                };
            }

            semCall('updateConsent', semConsentPayload(adConsent, analyticsConsent));

            
            
            semCall('track', 'PageView');

            
            
                        document.addEventListener('DOMContentLoaded', function () {
                shoptet.consent.onAccept(function (agreements) {
                    semCall('updateConsent', semConsentPayload(
                        agreements.includes(shoptet.config.cookiesConsentOptPersonalisation) ? 'granted' : 'denied',
                        agreements.includes(shoptet.config.cookiesConsentOptAnalytics) ? 'granted' : 'denied'
                    ));
                });
            });
                    })();
        /* ]]> */
    </script>
                            
