{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(beansmiths|merrybeans|typika|mlsnacava|tarani|coffeesource|fiftybeans|dosmundos|illimite|teamountain)\\.mojchatbot\\.sk$"
        }
      ],
      "destination": "/cosmetics.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}