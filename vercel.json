{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(beansmiths|merrybeans|typika|mlsnacava|tarani|coffeesource|fiftybeans|dosmundos|illimite|teamountain|vitellaria|ethia|pureharmony|voznice|ceskava|kamikava|laprazirna|mydlozfarmy|kafeprosebe|poppybeans|mohaji|ambere|mydlenka|zrna|johnnycoffee|mydlove|rae)(\\.mojchatbot\\.sk|-mojchatbot\\.vercel\\.app)$"
        }
      ],
      "destination": "/cosmetics.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "^(beansmiths|merrybeans|typika|mlsnacava|tarani|coffeesource|fiftybeans|dosmundos|illimite|teamountain|vitellaria|ethia|pureharmony|voznice|ceskava|kamikava|laprazirna|mydlozfarmy|kafeprosebe|poppybeans|mohaji|ambere|mydlenka|zrna|johnnycoffee|mydlove|rae)(\\.mojchatbot\\.sk|-mojchatbot\\.vercel\\.app)$"
        }
      ],
      "destination": "/cosmetics.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}