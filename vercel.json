{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(?<sub>verticcio|rebelbean|doubleshot|fathers|candycane|9gramscoffee|saloos|renovality|nobilistilia|manufaktura)\\.mojchatbot\\.sk$"
        }
      ],
      "destination": "/:sub.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(?<sub>praziarnicka|diamonds|kaffa|vitazov|concept|jolka|goriffee|readyafter|coffeesheep|zlatezrnko|becafe|simplecoffee|ebenica|casadelcaffe|coffeeveronia|grandroastery|coffeein|kavoholik|donfranko|ajvencoffee|kavavra|grain)\\.mojchatbot\\.sk$"
        }
      ],
      "destination": "/:sub.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(?<sub>mylo|ponio|two|bellcoria|biofy|anemone|modrapupava|facederma|cyprianus|panakeia|barboralori|bellmedi|lavelin|kvitok|soaphoria|syncare|fytopharma|natureal)\\.mojchatbot\\.sk$"
        }
      ],
      "destination": "/cosmetics.html"
    },
    {
      "source": "/kozmetika/:slug",
      "destination": "/cosmetics.html"
    },
    {
      "source": "/kozmetika/:slug/",
      "destination": "/cosmetics.html"
    },
    {
      "source": "/ukazka/jolka",
      "destination": "/jolka.html"
    },
    {
      "source": "/ukazka/jolka/",
      "destination": "/jolka.html"
    },
    {
      "source": "/ukazka/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/ukazka/:slug/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/verzia.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/:slug(praziarnicka|concept|kaffa|vitazov|diamonds|jolka|goriffee|readyafter|coffeesheep|zlatezrnko|becafe|simplecoffee|ebenica|casadelcaffe|coffeeveronia|grandroastery|coffeein|kavoholik|mylo|ponio|two|bellcoria|biofy|anemone|modrapupava|facederma|cyprianus|panakeia|barboralori|bellmedi|lavelin|kvitok|soaphoria|syncare|fytopharma|natureal|donfranko|ajvencoffee|kavavra|grain)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:slug(praziarnicka|concept|kaffa|vitazov|diamonds|jolka|goriffee|readyafter|coffeesheep|zlatezrnko|becafe|simplecoffee|ebenica|casadelcaffe|coffeeveronia|grandroastery|coffeein|kavoholik|mylo|ponio|two|bellcoria|biofy|anemone|modrapupava|facederma|cyprianus|panakeia|barboralori|bellmedi|lavelin|kvitok|soaphoria|syncare|fytopharma|natureal|donfranko|ajvencoffee|kavavra|grain)/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ukazka/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/kozmetika/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.js": {
      "includeFiles": "{coffee-catalogues/*.js,coffee-reply-core.js,chat-brain.js,chat-adapters.js}"
    },
    "api/cosmetics-chat.js": {
      "includeFiles": "{catalogues/*-refresh.js,advisor-core.js,catalogue-reply-core.js,catalogue-data.js,chat-brain.js,chat-adapters.js}"
    }
  }
}
