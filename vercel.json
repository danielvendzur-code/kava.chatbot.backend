{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/ukazka/papelote",
      "destination": "/s5-papelote.html"
    },
    {
      "source": "/ukazka/verticeramics",
