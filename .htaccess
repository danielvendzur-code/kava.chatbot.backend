Options -MultiViews
RewriteEngine On

# One public hostname per coffee demo. Serve the matching showcase at `/`
# without redirecting the browser away from its own subdomain.
RewriteCond %{HTTP_HOST} ^(praziarnicka|concept|kaffa|vitazov|diamonds|jolka|goriffee|readyafter|coffeesheep|zlatezrnko|becafe|simplecoffee|ebenica|casadelcaffe|coffeeveronia|grandroastery|coffeein|kavoholik)\.mojchatbot\.sk$ [NC]
RewriteRule ^$ %1.html [L]

# Real files/assets remain directly accessible from the shared document root.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
